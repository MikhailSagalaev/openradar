{
  "name": "radar",
  "version": "0.26.2",
  "private": true,
  "description": "Self-hosted lead pipeline for public order sources",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "radar": "./bin/radar.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:extension": "node scripts/pack-extension.js",
    "new:connector": "tsx src/cli/index.ts new-connector",
    "start": "node bin/radar.js",
    "rebuild": "pnpm rebuild"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mtcute/node": "0.32.7",
    "@noble/curves": "^2.4.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "pg": "^8.13.1",
    "rss-parser": "^3.13.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
