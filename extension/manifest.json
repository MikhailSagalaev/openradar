{
  "manifest_version": 3,
  "name": "OpenRadar — захват вакансий и заказов",
  "version": "0.9.0",
  "description": "Вакансии и заказы в открытую базу OpenRadar в один клик и оценка оплаты по рынку. Только по вашей команде.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "identity",
    "scripting",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Отправить в OpenRadar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Отправить текущую страницу в OpenRadar"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "connected.html"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
