{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "node_modules/**", "sdk/**", ".research/**", ".firecrawl/**", "coverage/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": "off",
    "no-useless-escape": "off",
    "no-control-regex": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-length-check": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-string-starts-ends-with": "off"
  },
  "overrides": [
    {
      "files": ["extension/**/*.js"],
      "env": {
        "browser": true,
        "webextensions": true,
        "node": false
      }
    }
  ]
}
