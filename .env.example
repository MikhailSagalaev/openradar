# Core Server Configuration
PORT=8787
RADAR_HOST_PORT=8787
NODE_ENV=production

# Security: In production, RADAR_ADMIN_TOKEN must be at least 32 characters long.
# Generate via: openssl rand -hex 32
RADAR_ADMIN_TOKEN=your_secure_random_admin_token_here_at_least_32_chars

# GitHub OAuth (required for voting and adding leads via /submit).
# Create an OAuth App at https://github.com/settings/developers
# with the Authorization callback URL: https://your-domain/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (PostgreSQL 17 + pgvector)
POSTGRES_USER=radar
POSTGRES_DB=radar
POSTGRES_PASSWORD=your_secure_random_postgres_password_here
DATABASE_URL=postgres://radar:your_secure_random_postgres_password_here@postgres:5432/radar

# General Settings
RADAR_USER_AGENT=RadarBot/0.4.2 (+https://github.com/MikhailSagalaev/radar-oss)
RADAR_HTTP_TIMEOUT_MS=15000
RADAR_POLL_INTERVAL_SEC=300
RADAR_LOG_LEVEL=info
RADAR_PUBLIC_READ=false

# Sinks (Alerts & Webhooks)
# Telegram digest bot (periodic top-leads digest to a chat)
RADAR_DIGEST_CHAT_ID=
RADAR_DIGEST_INTERVAL_HOURS=6

# Public base URL used in digest links
RADAR_PUBLIC_URL=https://openradar.fun

RADAR_CONSOLE_SINK=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional LLM classifier (OpenAI-compatible API)
RADAR_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
