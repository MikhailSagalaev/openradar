# Core Server Configuration
PORT=8787
RADAR_HOST_PORT=8787
# Interface the server listens on. 127.0.0.1 by default; the Docker image sets 0.0.0.0.
# RADAR_BIND=127.0.0.1
NODE_ENV=production

# Security: In production, RADAR_ADMIN_TOKEN must be at least 32 characters long.
# Generate via: openssl rand -hex 32
# Without it `radar serve` prints a one-off token for each run.
RADAR_ADMIN_TOKEN=your_secure_random_admin_token_here_at_least_32_chars

# Admins who sign in with GitHub instead of the token: numeric GitHub ids (safer,
# a login can be renamed) or logins, comma-separated. Find your id: https://api.github.com/users/<login>
# RADAR_ADMIN_GITHUB=

# GitHub OAuth (required for voting and adding leads via /submit).
# Create an OAuth App at https://github.com/settings/developers
# with the Authorization callback URL: https://your-domain/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (PostgreSQL 17 + pgvector)
POSTGRES_USER=radar
POSTGRES_DB=radar
POSTGRES_PASSWORD=your_secure_random_postgres_password_here
DATABASE_URL=postgres://radar:your_secure_random_postgres_password_here@postgres:5432/radar

# General Settings
RADAR_USER_AGENT=RadarBot/0.12.0 (+https://github.com/MikhailSagalaev/openradar)
RADAR_HTTP_TIMEOUT_MS=15000
RADAR_POLL_INTERVAL_SEC=300
# Sources polled at once; HTTP-bound, so a high number is safe.
RADAR_POLL_CONCURRENCY=16
# Close leads the boards show as closed; orders and vacancies leave the feed after these days (0 = never).
RADAR_CHECK_CLOSED=true
RADAR_GIG_TTL_DAYS=14
RADAR_JOB_TTL_DAYS=30
RADAR_LOG_LEVEL=info
RADAR_PUBLIC_READ=true
# Per-IP requests per minute on public pages, RSS, /api/delta and the sitemap (counted per process).
RADAR_FEED_RATE_PER_MIN=120
RADAR_RSS_RATE_PER_MIN=60
RADAR_DELTA_RATE_PER_MIN=30
RADAR_SITEMAP_RATE_PER_MIN=10

# Kwork closed API (optional): without them the adapter parses the public page
RADAR_KWORK_LOGIN=
RADAR_KWORK_PASSWORD=

# Telegram digest bot (periodic top-leads digest to a chat)
RADAR_DIGEST_CHAT_ID=
RADAR_DIGEST_INTERVAL_HOURS=6

# Public base URL used in digest links, the sitemap and social cards
RADAR_PUBLIC_URL=https://openradar.fun

# Optional web analytics and search console verification, off when empty.
# RADAR_YANDEX_METRIKA_ID=      # counter number
# RADAR_GA_ID=                  # G-XXXXXXXXXX
# RADAR_GOOGLE_SITE_VERIFICATION=   # content of the google-site-verification meta tag
# RADAR_YANDEX_VERIFICATION=    # code from yandex_<code>.html

# Outbound proxy for network-blocked sources (Telegram t.me previews).
# Example: RADAR_PROXY_URL=http://user:pass@proxy-host:8080 or socks5://...
RADAR_PROXY_URL=

# radar/2 mode: `node` = self-hosted, no feed delays; `hub` = shared network hub
# with tier delays (guest/member/active/core) and guests without contacts.
RADAR_MODE=node
# Tier delays in minutes (hub mode only), defaults shown:
# RADAR_TIER_DELAYS=guest=720,member=180,active=30,core=0
# Hub moderators: comma-separated hex public keys (core tier, final say on hidden leads).
# RADAR_MODERATORS=
# Hub: secret the web participant keys of GitHub accounts are derived from. Set it once and
# never change it, or the accounts lose their rating. Generate: openssl rand -hex 32
# RADAR_WEB_KEY_SECRET=

# Node -> hub: send sources marked `share` to the hub, signed with your participant key.
# Create a key with `radar key`; keep the nsec secret, your rating is bound to it.
# RADAR_HUB_URL=https://openradar.fun
# RADAR_NODE_KEY=nsec1...

# IMAP sources read their password only from variables named RADAR_IMAP_*
# RADAR_IMAP_PASSWORD=

# Telegram through your own account: app keys from my.telegram.org/apps, the session from
# `radar telegram login`. More accounts: RADAR_TELEGRAM_SESSION_<NAME>.
# RADAR_TELEGRAM_API_ID=
# RADAR_TELEGRAM_API_HASH=
# RADAR_TELEGRAM_SESSION=

RADAR_CONSOLE_SINK=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional LLM classifier (OpenAI-compatible API)
RADAR_LLM_ENABLED=false
# Outbound proxy (HTTP CONNECT) for sources with config.proxy: true and public Telegram
# previews, on hosts where some boards are blocked. Tor's HTTPTunnelPort works.
# RADAR_PROXY_URL=http://127.0.0.1:9080
# The Telegram account source (MTProto) through a proxy: socks5://host:port, http://...,
# or a t.me/proxy MTProxy link.
# RADAR_TELEGRAM_PROXY=socks5://127.0.0.1:9050

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Model extraction for /research: a language model reads free-text posts (Telegram, FL.ru,
# Kwork) for pay, role and grade. Uses the OpenAI-compatible API above (OpenAI, DeepSeek,
# OpenRouter, a local Ollama) or GigaChat. Rules and page markup always win; answers below
# 70% confidence are not used. About 1-2 thousand tokens per post.
RADAR_EXTRACT_ENABLED=false
# RADAR_EXTRACT_MODEL=           # another model than OPENAI_MODEL (GigaChat: GigaChat-2-Pro)
# RADAR_EXTRACT_PER_HOUR=300     # posts per hour; 0 stops it
# Answers are saved but stay out of the figures until this is true: check them first with
# `radar research check`.
# RADAR_EXTRACT_APPLY=false
# GigaChat (Sber): the authorization key from the developer cabinet, not a token.
# RADAR_EXTRACT_PROVIDER=gigachat
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS   # GIGACHAT_API_B2B or GIGACHAT_API_CORP for companies
