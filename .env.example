# Core Server Configuration
PORT=8787
RADAR_HOST_PORT=8787
# Interface the server listens on. 127.0.0.1 by default; the Docker image sets 0.0.0.0.
# RADAR_BIND=127.0.0.1
NODE_ENV=production

# Security: In production, RADAR_ADMIN_TOKEN must be at least 32 characters long.
# Generate via: openssl rand -hex 32
# Without it `radar serve` prints a one-off token for each run.
RADAR_ADMIN_TOKEN=your_secure_random_admin_token_here_at_least_32_chars

# Admins who sign in with GitHub instead of the token: numeric GitHub ids (safer,
# a login can be renamed) or logins, comma-separated. Find your id: https://api.github.com/users/<login>
# RADAR_ADMIN_GITHUB=

# GitHub OAuth (required for voting and adding leads via /submit).
# Create an OAuth App at https://github.com/settings/developers
# with the Authorization callback URL: https://your-domain/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (PostgreSQL 17 + pgvector)
POSTGRES_USER=radar
POSTGRES_DB=radar
POSTGRES_PASSWORD=your_secure_random_postgres_password_here
DATABASE_URL=postgres://radar:your_secure_random_postgres_password_here@postgres:5432/radar

# General Settings
RADAR_USER_AGENT=RadarBot/0.8.0 (+https://github.com/MikhailSagalaev/openradar)
RADAR_HTTP_TIMEOUT_MS=15000
RADAR_POLL_INTERVAL_SEC=300
RADAR_LOG_LEVEL=info
RADAR_PUBLIC_READ=true

# Kwork closed API (optional): without them the adapter parses the public page
RADAR_KWORK_LOGIN=
RADAR_KWORK_PASSWORD=

# Telegram digest bot (periodic top-leads digest to a chat)
RADAR_DIGEST_CHAT_ID=
RADAR_DIGEST_INTERVAL_HOURS=6

# Public base URL used in digest links, the sitemap and social cards
RADAR_PUBLIC_URL=https://openradar.fun

# Optional web analytics and search console verification, off when empty.
# RADAR_YANDEX_METRIKA_ID=      # counter number
# RADAR_GA_ID=                  # G-XXXXXXXXXX
# RADAR_GOOGLE_SITE_VERIFICATION=   # content of the google-site-verification meta tag
# RADAR_YANDEX_VERIFICATION=    # code from yandex_<code>.html

# Outbound proxy for network-blocked sources (Telegram t.me previews).
# Example: RADAR_PROXY_URL=http://user:pass@proxy-host:8080 or socks5://...
RADAR_PROXY_URL=

# radar/2 mode: `node` = self-hosted, no feed delays; `hub` = shared network hub
# with tier delays (guest/member/active/core) and guests without contacts.
RADAR_MODE=node
# Tier delays in minutes (hub mode only), defaults shown:
# RADAR_TIER_DELAYS=guest=720,member=180,active=30,core=0
# Hub moderators: comma-separated hex public keys (core tier, final say on hidden leads).
# RADAR_MODERATORS=

# Node -> hub: send sources marked `share` to the hub, signed with your participant key.
# Create a key with `radar key`; keep the nsec secret, your rating is bound to it.
# RADAR_HUB_URL=https://openradar.fun
# RADAR_NODE_KEY=nsec1...

# IMAP sources read their password only from variables named RADAR_IMAP_*
# RADAR_IMAP_PASSWORD=

RADAR_CONSOLE_SINK=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional LLM classifier (OpenAI-compatible API)
RADAR_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
